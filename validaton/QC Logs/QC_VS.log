 246        /*==========================================================
 247          11. FINAL SUMMARY
 248        ==========================================================*/
 249        proc sql;
 250            title3 "11. QC Summary — VS Domain";
 251            select  "Total Records"                 as Check length=35,
 252                    put(count(*), 8.)               as Result
 253            from sdtm.vs
 254            union all
 255            select  "Distinct Subjects",
 256                    put(count(distinct USUBJID), 8.)
 257            from sdtm.vs
 258            union all
 259            select  "Distinct Test Codes",
 260                    put(count(distinct VSTESTCD), 8.)
 261            from sdtm.vs
 262            union all
 263            select  "Missing VSSTRESN",
 264                    put(sum(VSSTRESN = .), 8.)
 265            from sdtm.vs
 266            union all
 267            select  "Missing VSDTC",
 268                    put(sum(VSDTC = ""), 8.)
 269            from sdtm.vs
 270            union all
 271            select  "VSDY = 0 (should be 0)",
 272                    put(sum(VSDY = 0), 8.)
 273            from sdtm.vs;
 274        quit;
