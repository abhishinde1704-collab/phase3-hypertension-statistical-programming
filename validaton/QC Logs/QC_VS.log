 151            title3 "1. Record & Subject Counts";
 152            select  count(*)                 as N_Records,
 153                    count(distinct USUBJID)  as N_Subjects,
 154                    count(distinct VSTESTCD) as N_Tests
 155            from sdtm.vs;
 156        quit;
