 235        /*==========================================================
 236          9. RFSTDTC MUST MATCH FIRST EXSTDTC IN EX
 237        ==========================================================*/
 238        proc sql;
 239            title "QC DM — RFSTDTC vs First EXSTDTC";
 240            select  d.USUBJID,
 241                    d.RFSTDTC       as DM_RFSTDTC,
 242                    min(e.EXSTDTC)  as FIRST_EX
 243            from sdtm.dm as d
 244            left join sdtm.ex as e
 245              on d.USUBJID = e.USUBJID
 246            group by d.USUBJID, d.RFSTDTC;
 247        quit;
