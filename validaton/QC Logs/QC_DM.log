 215        /*==========================================================
 216          8. AGE DERIVATION CHECK
 217           AGE should match BRTHDTC vs RFSTDTC
 218        ==========================================================*/
 219        data _check_age;
 220            set sdtm.dm;
 221            if not missing(BRTHDTC) and not missing(RFSTDTC) then do;
 222                BDT = input(BRTHDTC, yymmdd10.);
 223                RDT = datepart(input(RFSTDTC, e8601dt16.));
 224                CALC_AGE = floor((RDT - BDT) / 365.25);
 225                if abs(AGE - CALC_AGE) > 1 then output;
 226            end;
 227        run;
 
 NOTE: There were 100 observations read from the data set SDTM.DM.
 NOTE: The data set WORK._CHECK_AGE has 0 observations and 23 variables.
