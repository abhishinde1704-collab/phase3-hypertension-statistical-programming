 172        /*==========================================================
 173          4. USUBJID FORMAT CHECK
 174           USUBJID should be SITEID-SUBJID
 175        ==========================================================*/
 176        data _check_usubjid;
 177            set sdtm.dm;
 178            length EXPECTED $40;
 179            EXPECTED = catx("-",STUDYID,SUBJID);
 180            if USUBJID ne EXPECTED then output;
 181        run;
 
