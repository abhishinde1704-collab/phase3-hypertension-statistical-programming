 259        /*==========================================================
 260          11. SUMMARY DASHBOARD
 261        ==========================================================*/
 262        proc sql;
 263            title "QC DM — Summary Dashboard";
 264            select "Total Records"     as Check length = 25,
 265                   put(count(*), 8.)   as Value
 266            from sdtm.dm
 267            union all
 268            select "Distinct Subjects",
 269                   put(count(distinct USUBJID), 8.)
 270            from sdtm.dm
 271            union all
 272            select "HTN-101 Subjects",
 273                   put(sum(ARMCD = "HTN101"), 8.)
 274            from sdtm.dm
 275            union all
 276            select "Placebo Subjects",
 277                   put(sum(ARMCD = "PBO"), 8.)
 278            from sdtm.dm
 279            union all
 280            select "Missing RFSTDTC",
 281                   put(sum(RFSTDTC = ""), 8.)
 282            from sdtm.dm;
 283        quit;
