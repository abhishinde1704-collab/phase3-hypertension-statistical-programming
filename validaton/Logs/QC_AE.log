 349        proc sql;
 350            title3 "13. QC Summary — AE Domain";
 351            select  "Total Records"      as Check length=40,
 352                    put(count(*), 8.)    as Result
 353            from sdtm.ae
 354            union all
 355            select  "Distinct Subjects",
 356                    put(count(distinct USUBJID), 8.)
 357            from sdtm.ae
 358            union all
