 363            select  "Ongoing AEs (AEENRF = ONGOING)",
 364                    put(sum(AEENRF = "ONGOING"), 8.)
 365            from sdtm.ae
 366            union all
 367            select  "Missing AETERM",
 368                    put(sum(missing(AETERM)), 8.)
