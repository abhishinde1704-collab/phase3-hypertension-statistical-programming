 332        /*==========================================================
 333          12. AE START DATE ON/AFTER FIRST DOSE (Informational)
 334        ==========================================================*/
 335        proc sql;
 336            title3 "12. AEs with AESTDTC Before RFSTDTC — Preview of TEAE logic";
 337            select  a.USUBJID, a.AESEQ, a.AETERM, a.AESTDTC,
 338                    d.RFSTDTC
 339            from sdtm.ae as a
 340            left join sdtm.dm as d
 341              on a.USUBJID = d.USUBJID
 342            where a.AESTDTC ne "" and d.RFSTDTC ne ""
 343              and input(a.AESTDTC, yymmdd10.) < input(d.RFSTDTC, yymmdd10.);
