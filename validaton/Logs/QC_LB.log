 265        /*==========================================================
 266          12. FINAL SUMMARY
 267        ==========================================================*/
 268        proc sql;
 269            title3 "12. QC Summary — LB Domain";
 270            select  "Total Records"                 as Check length=35,
 271                    put(count(*), 8.)               as Result
 272            from sdtm.lb
 273            union all
 274            select  "Distinct Subjects",
 275                    put(count(distinct USUBJID), 8.)
 276            from sdtm.lb
 277            union all
 278            select  "Distinct Test Codes",
 279                    put(count(distinct LBTESTCD), 8.)
 280            from sdtm.lb
 281            union all
 282            select  "Distinct Categories",
 283                    put(count(distinct LBCAT), 8.)
 284            from sdtm.lb
 285            union all
 286            select  "Missing LBORRES",
 287                    put(sum(missing(LBORRES)), 8.)
 288            from sdtm.lb
 289            union all
 290            select  "Missing LBDTC",
 291                    put(sum(missing(LBDTC)), 8.)
 292            from sdtm.lb
 293            union all
 294            select  "LBDY = 0 (should be 0)",
 295                    put(sum(LBDY = 0), 8.)
 296            from sdtm.lb;
 297        quit;
