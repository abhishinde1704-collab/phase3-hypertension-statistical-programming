 147        /*==========================================================
 148          1. RECORD & SUBJECT COUNT
 149        ==========================================================*/
 150        proc sql;
 151            title3 "1. Record & Subject Counts";
 152            select  count(*)                 as N_Records,
 153                    count(distinct USUBJID)  as N_Subjects,
 154                    count(distinct LBTESTCD) as N_Tests
 155            from sdtm.lb;
 156        quit;
