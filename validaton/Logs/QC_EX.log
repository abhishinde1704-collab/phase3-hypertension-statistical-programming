 257        /*==========================================================
 258          11. FINAL SUMMARY
 259        ==========================================================*/
 260        proc sql;
 261            title3 "11. QC Summary — EX Domain";
 262            select  "Total Records"             as Check length=30,
 263                    put(count(*), 8.)           as Result
 264            from sdtm.ex
 265            union all
 266            select  "Distinct Subjects",
 267                    put(count(distinct USUBJID), 8.)
 268            from sdtm.ex
 269            union all
 270            select  "HTN-101 Records",
 271                    put(sum(EXTRT = "HTN-101"), 8.)
 272            from sdtm.ex
 273            union all
 274            select  "Placebo Records",
 275                    put(sum(EXTRT = "PLACEBO"), 8.)
 276            from sdtm.ex
 277            union all
 278            select  "Missing EXSTDTC",
 279                    put(sum(EXSTDTC = ""), 8.)
 280            from sdtm.ex
