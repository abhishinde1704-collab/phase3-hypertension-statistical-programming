 201        /*==========================================================
 202          7. DATE LOGIC — EXSTDTC ≤ EXENDTC
 203        ==========================================================*/
 204        data _check_dates;
 205            set sdtm.ex;
 206            if not missing(EXSTDTC) and not missing(EXENDTC) then do;
 207                EXSTDT = input(EXSTDTC, e8601dt16.);
 208                EXENDT = input(EXENDTC, e8601dt16.);
 209                if EXSTDT > EXENDT then output;
 210            end;
 211        run;
 
