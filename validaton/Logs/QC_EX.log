 237        /*==========================================================
 238          10. RFXSTDTC (DM) should match min(EXSTDTC) per subject
 239        ==========================================================*/
 240        proc sql;
 241            create table ex_min as
 242            select USUBJID, min(EXSTDTC) as MIN_EXSTDTC
 243            from sdtm.ex
 244            group by USUBJID;
 NOTE: Table WORK.EX_MIN created, with 100 rows and 2 columns.
 
 245        
 246            create table _check_rfx as
 247            select d.USUBJID, d.RFXSTDTC, e.MIN_EXSTDTC
 248            from sdtm.dm as d
 249            left join ex_min as e
 250              on d.USUBJID = e.USUBJID
 251            where d.RFXSTDTC ne e.MIN_EXSTDTC;
 NOTE: Table WORK._CHECK_RFX created, with 0 rows and 3 columns.
 
